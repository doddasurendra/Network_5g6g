# Security Configuration Template
# DO NOT COMMIT REAL TOKENS OR SECRETS

# IBM Quantum Runtime Service API Token (Get from https://quantum.ibm.com)
QISKIT_IBM_TOKEN=your_ibm_quantum_api_token_here

# Database URL (Default SQLite or PostgreSQL)
DATABASE_URL=sqlite:///./telecom_intelligence.db
# DATABASE_URL=postgresql://user:password@localhost:5432/telecom_intelligence

# API Server Host & Port
API_HOST=0.0.0.0
API_PORT=8000
